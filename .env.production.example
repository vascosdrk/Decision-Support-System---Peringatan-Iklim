# ==============================================================================
# DSS-PIK BMKG Kepulauan Riau — PRODUCTION ENVIRONMENT TEMPLATE
# Copy to `.env.production` (chmod 600 .env.production), NEVER commit to Git.
# Generate unique strong credentials directly on the Ubuntu Server!
# ==============================================================================

# Explicit Release Image Version (NEVER use `latest` alone in production)
DSS_PIK_VERSION=1.0.0

# Network Ingress (Default: loopback-only behind Nginx/Caddy reverse proxy)
DSS_PIK_BIND_IP=127.0.0.1
DSS_PIK_HOST_PORT=8000

# Host path to canonical operational data directory (mounted read-only)
DSS_PIK_DATA_DIR=/srv/dss-pik/data

# MariaDB Production Database (Internal Docker Network `mariadb:3306`)
CEWS_DB_NAME=cews_db
CEWS_DB_USER=dsspik_prod
CEWS_DB_PASSWORD=GENERATE_STRONG_UNIQUE_APP_PASSWORD_32_CHARS
MARIADB_ROOT_PASSWORD=GENERATE_STRONG_UNIQUE_ROOT_PASSWORD_32_CHARS

# Application Authentication (Operator Login)
# Generate bcrypt hash on server:
#   docker run --rm dss-pik:1.0.0 python -c "import bcrypt, getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
# IMPORTANT: Wrap the bcrypt hash in single quotes '...' so Docker Compose does not expand '$'
DSS_PIK_USERNAME=klimatkepri
DSS_PIK_PASSWORD_HASH='$2b$12$REPLACE_WITH_GENERATED_BCRYPT_HASH_ON_SERVER'

# Generate 64-char hex session secret on server:
#   openssl rand -hex 32
DSS_PIK_SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_SESSION_SECRET
